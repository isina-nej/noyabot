# Lightweight profile: no collector is required.  Keep Django private and use
# an SSH tunnel: ssh -N -L 8000:127.0.0.1:8000 user@server
NOYA_ENVIRONMENT=production
NOYA_LOG_RING_CAPACITY=2000
NOYA_LOG_RETENTION_LINES=50000
NOYA_OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=

# Local CLI defaults. Keep the API key in a secret manager or a mode-600
# ~/.config/noyaops/config.toml; do not commit it to this file.
NOYAOPS_URL=http://127.0.0.1:8000/api/internal/ops/v1
NOYAOPS_TIMEOUT=8
NOYAOPS_RETRIES=2
NOYAOPS_RETRY_BACKOFF=0.5
NOYAOPS_POLL_INTERVAL=2
