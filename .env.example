# Development defaults. Production MUST set NOYA_ENVIRONMENT=production,
# DEBUG=false, secure DJANGO_SECRET_KEY and explicit ALLOWED_HOSTS.
# NOYA_ENVIRONMENT=production
# Django
DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Set DEBUG=false in production.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Tehran
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# SQLite defaults work without these database variables.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=group_bot
# DB_USER=group_bot
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Telegram
BOT_TOKEN=replace-with-botfather-token
# Optional: comma/space-separated tokens. BOT_TOKEN remains backward-compatible.
# BOT_TOKENS=first-botfather-token,second-botfather-token
BOT_USERNAME=NuyaRobot
ADMIN_IDS=123456789
TARGET_CHAT_ID=@your_required_channel

# AI service
AI_API_URL=https://ai.tinkera.org/api/chat
PROMPT_URL_PREFIX=https://ai.tinkera.org/chat/
NOYA_API_URL=http://127.0.0.1:20128/v1/chat/completions
NOYA_API_KEY=replace-with-9router-api-key
NOYA_MODEL=TinkeraBot
# Optional override when a photo/sticker is attached. Empty = use NOYA_MODEL.
# On current 9router, NoyaBest / gemini-* / sina-pro / fast accept image_url.
NOYA_VISION_MODEL=
# Speech-to-text: OpenAI-compatible transcription API (Whisper or compatible).
# If blank, NOYA_STT_API_URL is derived from NOYA_API_URL by replacing
# /chat/completions with /audio/transcriptions; verify your router supports it.
NOYA_STT_ENABLED=true
NOYA_STT_API_URL=
NOYA_STT_API_KEY=
NOYA_STT_MODEL=whisper-1
NOYA_STT_TIMEOUT=300
# Telegram cloud Bot API getFile normally supports files up to 20 MB.
NOYA_MEDIA_MAX_BYTES=20000000
NOYA_MEDIA_MAX_SECONDS=180
NOYA_MEDIA_MAX_TEXT_CHARS=16000
# On the bot host install ffmpeg (e.g. sudo apt install ffmpeg) for video frames,
# video audio extraction and conversion of uncommon audio formats.
# Noya's creator (defaults to first ADMIN_IDS entry + name Sina).
NOYA_CREATOR_IDS=1399836576
NOYA_CREATOR_NAME=Sina
NOYA_CREATOR_USERNAME=
# Batool's verified Telegram user ID; special affectionate tone only when
# she participates in this private chat or the current/recent group conversation.
# Presence does not grant admin permissions or imply romantic consent.
NOYA_BATOOL_USER_ID=1617351320
# Display-only username hint; authorization always checks numeric Telegram ID.
NOYA_BATOOL_USERNAME=InbI_19
# Optional comma-separated aliases people might use when talking about the creator.
NOYA_CREATOR_ALIASES=سینا,Sina,سازنده
NOYA_SYSTEM_PROMPT_ENABLED=true
# Live DuckDuckGo search for news/prices when the question needs it.
NOYA_SEARCH_ENABLED=true
NOYA_SEARCH_TIMEOUT=8
# Relationship emotion bands and natural hurt decay (0-100 scores).
NOYA_HURT_MILD_MAX=14
NOYA_HURT_SULKY_MAX=34
NOYA_HURT_NOTICEABLE_MAX=59
NOYA_HURT_SERIOUS_MAX=79
NOYA_HURT_MINOR_DECAY_PER_DAY=4
NOYA_HURT_SERIOUS_DECAY_PER_DAY=1
NOYA_RELATIONSHIP_EVENT_RETENTION_DAYS=90

# Admin agent (natural-language admin assistant)
# Master switch for the /agent, /adminai and "نویا،" admin triggers.
AGENT_ENABLED=true
# When true, commands the deterministic parser cannot classify are sent to the
# AI for strict JSON structured output. When false, only deterministic parsing
# is used (no AI calls for admin commands).
AGENT_AI_ENABLED=true
# Optional override for the agent model; falls back to NOYA_MODEL when empty.
AGENT_MODEL=
# Glass-key confirmation time-to-live (seconds) for sensitive operations.
AGENT_CONFIRMATION_TTL_SECONDS=120
# Minimum AI confidence required to act on an AI-parsed command.
AGENT_MIN_CONFIDENCE=0.80
# Maximum accepted admin command length (characters).
AGENT_MAX_COMMAND_LENGTH=2000
# ReAct harness: multi-step investigate (read tools + sandboxed Python on data).
AGENT_HARNESS_ENABLED=true
# When false, harness still runs a deterministic read-tool pass (no LLM planner).
AGENT_HARNESS_AI_ENABLED=true
AGENT_HARNESS_MAX_STEPS=8
# Untrusted Python in the harness is OFF for production by default.
NOYA_SANDBOX_ENABLED=false
# AI-first router: classify admin-ops vs ordinary chat (fail-open to chat).
AGENT_CLASSIFY_ENABLED=true
AGENT_CACHE_TTL_SECONDS=600
# Jev (SystemOne) fast path in front of the LLM classifier.
# Fail-open: when disabled, erroring, or ambiguous, the LLM path runs unchanged.
# JEV_ENABLED=false          # kill-switch: Jev fully off, zero behavior change
# JEV_MODEL=oc/jev-1.13-free # primary (free); must exist on your 9Router
# JEV_FALLBACK_MODEL=openrouter/typesafe/jev-1.13  # paid fallback; empty = none
# JEV_TIMEOUT=6              # seconds per Jev attempt
# JEV_COOLDOWN_SECONDS=120   # skip Jev this long after all models fail (0 = off)
# Media router (voice/image/none fast path before the LLM agent loop).
# JEV_MEDIA_ENABLED=false      # kill-switch for the media router only
# JEV_VOICE_CONFIDENCE=0.85    # min confidence to force TTS (strict: voice is loud)
# JEV_IMAGE_CONFIDENCE=0.75    # min confidence to force image generation
# Message archive (opt-in). Only archives messages the bot receives and records
# deletions the bot itself performs. Telegram gives no public event for manual
# deletions in ordinary groups.
MESSAGE_ARCHIVE_ENABLED=false
MESSAGE_ARCHIVE_RETENTION_DAYS=30

# Independent test bot (for live testing WITHOUT touching production @NuyaRobot).
# `manage.py run_testbot` uses ONLY TEST_BOT_TOKEN and never falls back to
# BOT_TOKEN. Create a separate bot in BotFather for this.
TEST_BOT_TOKEN=
TEST_GROUP_ID=
TEST_ADMIN_USER_ID=

# Memory core (phase 1)
SHORT_TERM_TTL_HOURS=24
MEDIUM_TERM_TTL_DAYS=14
LONG_TERM_TTL_DAYS=60
MEMORY_MAX_CONTEXT_TOKENS=600
# Private, bounded dialogue continuity across process restarts.
NOYA_DIALOGUE_ENABLED=true
NOYA_DIALOGUE_MAX_TURNS=12
NOYA_DIALOGUE_TTL_DAYS=14
# Optional spontaneous group participation: off by default, groups must allow AI.
NOYA_AMBIENT_REPLIES_ENABLED=false
NOYA_AMBIENT_MIN_MESSAGES=12
NOYA_AMBIENT_COOLDOWN_SECONDS=1800
# Context-aware reactions for short social acknowledgements; never replace questions/tasks.
# If Telegram disallows a reaction, no extra text reply is sent.
NOYA_REACTION_ENABLED=true
# Model may silently skip only low-stakes group chat; DMs and tasks always reply.
NOYA_SILENCE_ENABLED=true
# Reply immediately to an unquoted, name-only "نویا" without AI calls or a 60s wait.
NOYA_FAST_ACK_ENABLED=true
# When the same person asks a newer group question, don't post an obsolete
# five-minute timeout from their previous turn (successful results are kept).
NOYA_SUPPRESS_SUPERSEDED_TIMEOUTS=true
# Whole-turn AI deadline is 300 seconds; one waiting message is sent after 60s.
NOYA_API_TIMEOUT=300
# Telegram self-profile metadata is stored only after /profile_save in private chat.
# Run /profile_forget to clear consented profile fields.

# Cap active MemoryItem rows per (user, scope/conversation). Oldest non-critical
# items are soft-deleted when the cap is exceeded.
MEMORY_MAX_ITEMS_PER_SCOPE=200
MEMORY_EXTRACTION_ENABLED=true
MEMORY_RETRIEVAL_ENABLED=true
MEMORY_INGESTION_ENABLED=true
MEMORY_USER_COMMANDS_ENABLED=true
MEMORY_FAIL_OPEN=true
MEMORY_LATENCY_LOGGING_ENABLED=false

# Research layer (Web + X/Twitter + YouTube, read-only).
# X uses the official API v2 when X_BEARER_TOKEN is set (preferred);
# the local session bridge (x-bridge, cookies.json) is only used when
# explicitly enabled via X_SESSION_ENABLED=true.
X_RESEARCH_ENABLED=false
X_PROVIDER=official
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_SESSION_ENABLED=false
X_BRIDGE_URL=http://127.0.0.1:8791
# Mandatory for X Bridge; keep private and rotate regularly.
X_BRIDGE_INTERNAL_TOKEN=
# Move cookies outside the Git checkout before rotating X sessions.
# X_BRIDGE_COOKIES_FILE=/var/lib/noya-secrets/x-cookies.json
# YouTube Data API v3 key for public search/video/comments reads.
YOUTUBE_RESEARCH_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Channel analysis via MTProto (Telethon user session, read-only).
# Allows «نویا تحلیل» to read channel history (views/forwards/reactions)
# which the Bot API cannot access. The session must belong to an account
# that is a member of the target channel.
CHANNEL_ANALYSIS_ENABLED=true
# Get API credentials from https://my.telegram.org/apps
TELETHON_API_ID=
TELETHON_API_HASH=
# Path to the .session file. Defaults to noyabot.session in the project root.
TELETHON_SESSION_PATH=
# Timeout for a single channel history fetch (seconds).
CHANNEL_ANALYSIS_TIMEOUT=90

# Remote observability (safe defaults: local bounded ring, no external export).
NOYA_SERVICE_NAME=noyabot
NOYA_ENVIRONMENT=development
NOYA_RELEASE=
NOYA_GIT_COMMIT=
NOYA_TELEMETRY_HASH_KEY=
NOYA_LOG_RING_CAPACITY=2000
NOYA_LOG_RETENTION_LINES=50000
NOYA_OBSERVABILITY_ENABLED=true
# Set to an OTLP/HTTP collector only when telemetry export is desired.
NOYA_OTEL_EXPORTER_OTLP_HTTP_ENDPOINT=
NOYA_OTEL_CONSOLE=false
# Private ops API is protected by the existing X-API-Key authentication.
NOYAOPS_URL=http://127.0.0.1:8000/api/internal/ops/v1
NOYAOPS_API_KEY=
# Optional local CLI config and bounded retry/poll tuning. Prefer a mode-600
# ~/.config/noyaops/config.toml or a secret manager for the API key itself.
NOYAOPS_CONFIG=
NOYAOPS_TIMEOUT=8
NOYAOPS_RETRIES=2
NOYAOPS_RETRY_BACKOFF=0.5
NOYAOPS_POLL_INTERVAL=2

# Staff-only NoyaBot web inbox (disabled until explicitly enabled).
# Archives new private, group and channel updates received after activation.
BOT_INBOX_ENABLED=false
BOT_INBOX_SEND_ENABLED=false
BOT_INBOX_RETENTION_DAYS=30
# Required for sending; numeric bot ids must be in the same order as BOT_TOKENS.
# BOT_INBOX_BOT_IDS=8880029922,8803993138
# Optional: HTTPS address of your SELF-HOSTED upstream Telegram Web for Bots.
# BOT_WEB_URL=https://your-webbot.example.org
